# Uretim (Vercel) ortam degiskenleri. Gercek degerleri buraya YAZMA; Vercel panelinden gir.
# Neon Postgres "pooled" baglanti adresi (Vercel > Storage > Neon ile otomatik gelir)
DATABASE_URL=postgres://kullanici:sifre@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# /yonetim paneli sifresi (uzun ve tahmin edilemez olsun)
YONETIM_SIFRESI=
# Oturum cerezini imzalayan gizli anahtar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTURUM_SIRRI=
# Istege bagli: koy sahasi alt alan adi (ornek: koy.iytefutbol.com). Bu adrese gelen istek /koy-sahasi'ni acar.
KOY_HOST=
# Alan adi alininca
SITE_URL=
SITE_INDEXABLE=
